NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://approval:approval@localhost:5432/approval_workflow?schema=public

# Pino log level: fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info

# Requests allowed per client IP within the rate limit window (default 100)
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (default 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Request timeout in milliseconds (default 30 seconds)
REQUEST_TIMEOUT_MS=30000
